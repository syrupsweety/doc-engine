% APA 7th Edition Pandoc LaTeX Template
% Based on APA 7th edition formatting guidelines

\documentclass[12pt,letterpaper]{article}

% ============================================
% Required packages
% ============================================
\usepackage{ifxetex,ifluatex}
\usepackage{fixltx2e}
\usepackage{fontspec}
\usepackage{polyglossia}
$if(lang)$
\setmainlanguage{$lang$}
$else$
\setmainlanguage{english}
$endif$

% ============================================
% Font configuration - Times New Roman for APA
% ============================================
$if(mainfont)$
    \setmainfont{$mainfont$}
$else$
    \setmainfont{Times New Roman}
$endif$
$if(sansfont)$
    \setsansfont{$sansfont$}
$else$
    \setsansfont{Arial}
$endif$
$if(monofont)$
    \setmonofont{$monofont$}
$else$
    \setmonofont{Courier New}
$endif$

% ============================================
% Page geometry - 1 inch margins for APA
% ============================================
\usepackage{geometry}
\geometry{
    letterpaper,
    left=1in,
    right=1in,
    top=1in,
    bottom=1in,
    headheight=0.5in
}

% ============================================
% Line spacing - Double spacing for APA
% ============================================
\usepackage{setspace}
\doublespacing

% ============================================
% Bibliography using CSL (via pandoc-citeproc)
% ============================================
% CSL bibliography is handled by pandoc with --citeproc flag
% No biblatex configuration needed when using CSL

% ============================================
% Syntax highlighting (required for code blocks)
% ============================================
\usepackage{xcolor}
\usepackage{fvextra}
\DefineVerbatimEnvironment{Highlighting}{Verbatim}{breaklines,commandchars=\\\{\}}
\usepackage{framed}
\definecolor{shadecolor}{RGB}{240,240,240}
\newenvironment{Shaded}{\begin{snugshade}}{\end{snugshade}}

% Syntax highlighting commands
\newcommand{\KeywordTok}[1]{\textcolor[rgb]{0.00,0.00,1.00}{\textbf{#1}}}
\newcommand{\DataTypeTok}[1]{\textcolor[rgb]{0.00,0.00,1.00}{#1}}
\newcommand{\DecValTok}[1]{\textcolor[rgb]{0.00,0.00,1.00}{#1}}
\newcommand{\BaseNTok}[1]{\textcolor[rgb]{0.00,0.00,1.00}{#1}}
\newcommand{\FloatTok}[1]{\textcolor[rgb]{0.00,0.00,1.00}{#1}}
\newcommand{\CharTok}[1]{\textcolor[rgb]{0.00,0.50,0.00}{#1}}
\newcommand{\StringTok}[1]{\textcolor[rgb]{0.00,0.50,0.00}{#1}}
\newcommand{\CommentTok}[1]{\textcolor[rgb]{0.50,0.50,0.50}{\textit{#1}}}
\newcommand{\OtherTok}[1]{\textcolor[rgb]{0.00,0.50,0.00}{#1}}
\newcommand{\AlertTok}[1]{\textcolor[rgb]{1.00,0.00,0.00}{\textbf{#1}}}
\newcommand{\FunctionTok}[1]{\textcolor[rgb]{0.00,0.00,1.00}{#1}}
\newcommand{\RegionMarkerTok}[1]{#1}
\newcommand{\ErrorTok}[1]{\textcolor[rgb]{1.00,0.00,0.00}{\textbf{#1}}}
\newcommand{\NormalTok}[1]{#1}
\newcommand{\VariableTok}[1]{#1}
\newcommand{\ControlFlowTok}[1]{\textcolor[rgb]{0.00,0.00,1.00}{\textbf{#1}}}
\newcommand{\OperatorTok}[1]{#1}
\newcommand{\BuiltInTok}[1]{#1}
\newcommand{\ExtensionTok}[1]{#1}
\newcommand{\PreprocessorTok}[1]{\textcolor[rgb]{0.50,0.50,0.50}{\textit{#1}}}
\newcommand{\AttributeTok}[1]{#1}
\newcommand{\InformationTok}[1]{#1}
\newcommand{\WarningTok}[1]{\textcolor[rgb]{1.00,0.50,0.00}{\textbf{#1}}}

% Pandoc tightlist command
\providecommand{\tightlist}{%
  \setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}

% ============================================
% Graphics - with proper image sizing
% ============================================
\usepackage{graphicx}
\usepackage[export]{adjustbox}
\usepackage{float}
% Set default image width to text width while preserving aspect ratio
\setkeys{Gin}{width=\linewidth,keepaspectratio}

% ============================================
% Math
% ============================================
\usepackage{amsmath}
\usepackage{amssymb}

% ============================================
% Hyperlinks
% ============================================
\usepackage{hyperref}
\hypersetup{
    colorlinks=false,
    pdfborder={0 0 0},
    pdftitle={$title$},
    pdfauthor={$for(author)$$author.name$$sep$, $endfor$}
}

% ============================================
% Headers and footers - Running head for APA
% ============================================
\usepackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[R]{\thepage}
$if(runninghead)$
\fancyhead[L]{\MakeUppercase{$runninghead$}}
$else$
\fancyhead[L]{\MakeUppercase{$title$}}
$endif$
\renewcommand{\headrulewidth}{0pt}

% ============================================
% Paragraph formatting
% ============================================
\usepackage{indentfirst}
\setlength{\parindent}{0.5in}
\setlength{\parskip}{0pt}

% ============================================
% Tables
% ============================================
\usepackage{longtable}
\usepackage{booktabs}
\usepackage{array}

% ============================================
% Listings for code
% ============================================
\usepackage{listings}
\lstset{
    basicstyle=\ttfamily\small,
    breaklines=true,
    frame=single
}

% ============================================
% Title page command for APA
% ============================================
\makeatletter
\newcommand{\makeapatile}{
    \begin{center}
    \doublespacing
    $if(title)$
        \textbf{$title$}\\[2\baselineskip]
    $endif$
    
    $if(author)$
        $for(author)$
            $author.name$
            $if(author.affiliation)$
                \\$author.affiliation$
            $endif$
            $sep$\\[\baselineskip]
        $endfor$
    $endif$
    
    $if(authornote)$
        \\[2\baselineskip]
        \textbf{Author Note}\\
        $authornote$
    $endif$
    \end{center}
    \vspace{2\baselineskip}
}
\makeatother

% ============================================
% Custom commands
% ============================================
$for(header-includes)$
$header-includes$
$endfor$

\begin{document}

% ============================================
% Title Page
% ============================================
\makeapatile

% ============================================
% Abstract
% ============================================
$if(abstract)$
\begin{center}
\textbf{Abstract}
\end{center}
\noindent $abstract$

$if(keywords)$
\vspace{\baselineskip}
\noindent \textit{Keywords:} $for(keywords)$$keywords$$sep$, $endfor$
$endif$

\newpage
$endif$

% ============================================
% Main content
% ============================================
$body$

% ============================================
% Bibliography (CSL-generated)
% ============================================
$if(bibliography)$
\newpage
\begin{center}
\textbf{References}
\end{center}
$body$
$endif$

\end{document}
