<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0"
       demote-non-dropping-particle="never" default-locale="ru-RU">
  <info>
    <title>GOST 7.32 НИР — совпадение с оригиналом Word</title>
    <id>http://local/gost-nir</id>
    <updated>2026-11-05T00:00:00+00:00</updated>
  </info>

  <macro name="authors">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=" " delimiter=", "
            delimiter-precedes-last="always" initialize-with=". "
            et-al-min="99" et-al-use-first="99"/>
      <substitute>
        <names variable="editor"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="year">
    <date variable="issued"><date-part name="year"/></date>
  </macro>

  <macro name="pages">
    <group prefix="P.&#160;"><text variable="page"/></group>
  </macro>

  <citation>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>

  <bibliography entry-spacing="0" line-spacing="1">
    <layout suffix=".">
      <text variable="citation-number" suffix=". "/>
      <choose>

        <if type="article-journal article-magazine" match="any">
          <group delimiter=". – ">
            <group delimiter=" // ">
              <group delimiter=". ">
                <text macro="authors"/>
                <text variable="title"/>
              </group>
              <text variable="container-title"/>
            </group>
            <text macro="year"/>
            <group delimiter=", ">
              <group prefix="Vol.&#160;"><text variable="volume"/></group>
              <text variable="issue" prefix="№&#160;"/>
            </group>
            <text macro="pages"/>
            <text variable="DOI" prefix="DOI: "/>
          </group>
        </if>

        <else-if type="paper-conference chapter" match="any">
          <group delimiter=". – ">
            <group delimiter=" // ">
              <group delimiter=". ">
                <text macro="authors"/>
                <text variable="title"/>
              </group>
              <text variable="container-title"/>
            </group>
            <text macro="year"/>
            <text macro="pages"/>
          </group>
        </else-if>

        <else-if type="book" match="any">
          <group delimiter=". – ">
            <group delimiter=". ">
              <text macro="authors"/>
              <text variable="title"/>
            </group>
            <group delimiter=", ">
              <text variable="publisher"/>
              <text macro="year"/>
            </group>
          </group>
        </else-if>

        <else-if type="thesis" match="any">
          <group delimiter=". – ">
            <group delimiter=" : ">
              <group delimiter=". ">
                <text macro="authors"/>
                <text variable="title"/>
              </group>
              <text variable="genre"/>
            </group>
            <group delimiter=", ">
              <text variable="publisher"/>
              <text macro="year"/>
            </group>
          </group>
        </else-if>

        <else-if type="patent" match="any">
          <group delimiter=". – ">
            <group delimiter=" : ">
              <group delimiter=". ">
                <text macro="authors"/>
                <text variable="title"/>
              </group>
              <group delimiter=" ">
                <text value="пат."/>
                <text variable="number"/>
                <text variable="jurisdiction"/>
              </group>
            </group>
            <text variable="note"/>
          </group>
        </else-if>

        <else-if type="webpage post post-weblog" match="any">
          <group delimiter=". – ">
            <group delimiter=" // ">
              <group delimiter=". ">
                <text macro="authors"/>
                <text variable="title" suffix=" [Электронный ресурс]"/>
              </group>
              <text variable="container-title"/>
              <text variable="note"/>
            </group>
            <group delimiter=" ">
              <text variable="URL" prefix="URL: "/>
              <date variable="accessed" prefix="(дата обращения: " suffix=")">
                <date-part name="day" suffix="."/>
                <date-part name="month" form="numeric-leading-zeros" suffix="."/>
                <date-part name="year"/>
              </date>
            </group>
          </group>
        </else-if>

        <else>
          <group delimiter=". – ">
            <group delimiter=". ">
              <text macro="authors"/>
              <text variable="title"/>
            </group>
            <text macro="year"/>
            <group delimiter=", ">
              <text variable="publisher"/>
              <text variable="volume" prefix="Vol.&#160;"/>
              <text variable="issue" prefix="№&#160;"/>
            </group>
            <text macro="pages"/>
          </group>
        </else>

      </choose>
    </layout>
  </bibliography>
</style>
